# ==============================================================================
# THE VAGABOND — FULL RENDER ENVIRONMENT DRAFT
# ==============================================================================
# Every environment variable the codebase actually reads, confirmed by
# grepping os.Getenv(...)/getenv*(...) across the whole repo (2026-08-05) —
# not assumed from memory. The previous version of this file only listed 3
# of the 30 real variables (TELEGRAM_TOKEN, DATABASE_URL, GAME_TICK_SECONDS)
# and one that isn't read anywhere at all (APP_ENV, removed below) — that
# gap is very likely why AI_DEFAULT_PROVIDER/AI_FALLBACK_PROVIDERS have been
# misconfigured on Render before (env var *names* pasted in where provider
# *names* belong — see BUGS_AND_INCONSISTENCIES.md, 2026-08-02). Copy the
# variables you need into Render's dashboard (Environment tab) — do NOT
# upload this file itself with real secrets filled in.
#
# Every variable below is optional unless marked REQUIRED — the bot boots
# and runs (mock AI, no admin access) with zero configuration at all.
# ==============================================================================


# ------------------------------------------------------------------------------
# CORE — REQUIRED to boot at all
# ------------------------------------------------------------------------------

# Telegram bot token from @BotFather. Boot fails immediately without this.
TELEGRAM_TOKEN=1234567890:YOUR_TELEGRAM_BOT_TOKEN

# Supabase/Postgres 16 connection string. Boot fails immediately without
# this. Use the *pooler* (PgBouncer, port 6543 or 5432 depending on your
# Supabase plan) connection string, not the direct-connection one, for a
# Render deployment — see internal/dbdriver's SQLSTATE 26000 workaround in
# BUGS_AND_INCONSISTENCIES.md if you ever see
# "pq: unnamed prepared statement does not exist" errors (already handled
# in code, just documenting why the pooler URL is fine to use).
# Format: postgres://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require


# ------------------------------------------------------------------------------
# CORE — optional, strongly recommended
# ------------------------------------------------------------------------------

# Comma-separated Telegram numeric user IDs (not usernames) with admin
# access — /admin panel, /ai_status, /ai_probe, /ai_status_toggle, DB-reset
# confirmation flow, broadcasts, gifts, etc. Leave empty and every admin
# surface is inaccessible (logged as a warning at boot, not a hard failure).
# Get your own numeric ID from @userinfobot on Telegram.
ADMIN_IDS=123456789,987654321

# Seconds between game-engine ticks (raid resolution, tax collection,
# weather rolls, AI faction decisions, notification dispatch cadence, etc.)
# Default: 60. Must be a positive integer — a non-positive/unparseable
# value silently falls back to the 60s default (NewEngine guards against
# the boot-crashing panic a bad value used to cause — see
# BUGS_AND_INCONSISTENCIES.md, 2026-08-02).
GAME_TICK_SECONDS=60


# ------------------------------------------------------------------------------
# CORE — set automatically by Render, only override for local/other hosting
# ------------------------------------------------------------------------------

# HTTP port for the /health check endpoint. Render injects this
# automatically for a Web Service — do not set it manually on Render.
# Only needed if you're running this somewhere that doesn't set $PORT.
# Default: 8080
PORT=8080

# If set, a background goroutine GETs this URL every 10 minutes to defeat
# Render's free-tier idle-sleep. Point it at your own deployed /health URL,
# e.g. https://the-vagabond.onrender.com/health. Leave unset on a paid
# Render plan that doesn't idle-sleep, or if you're using an external
# uptime pinger instead (UptimeRobot, cron-job.org, etc.).
SELF_PING_URL=


# ==============================================================================
# AI FOUNDATION (Phase A) — internal/ai
# ==============================================================================
# Every AI-driven feature (Planet Governor, Fleet Commander, Economy/
# Research/Battle/Guild/Galaxy/NPC advisors, Dev Console, the natural-
# language command interpreter) routes through this one config. Zero AI
# vars set = every feature still works, using the built-in zero-cost mock
# provider (clearly labeled "PLACEHOLDER" output, never presented as real).
# Set any ONE real provider's *_API_KEY below to get genuine AI output for
# every feature — no other code change needed.
#
# After setting any key, use the in-Telegram admin diagnostics rather than
# assuming it worked:
#   /ai_status  — shows which providers are configured + feature flags
#   /ai_probe   — fires one real test call at each configured provider and
#                 shows the EXACT error (quota/auth/model-access/etc.) if
#                 one is silently falling through to mock. Start here if
#                 AI output still looks like PLACEHOLDER after setting a key.
# ==============================================================================

# Master kill switch for the entire AI foundation. false = every AI feature
# returns "AI is currently disabled" instead of even trying mock.
# Default: true
AI_ENABLED=true

# Which provider is tried FIRST. Must be a provider *name* — one of:
# anthropic, openai, deepseek, qwen, grok, gemini, ollama, mock.
# Do NOT put an env var name here (e.g. "GEMINI_API_KEY") — that's a
# confirmed past misconfiguration on this project (harmless because
# Registry.Ordered() silently skips unrecognized names and still tries
# every registered provider anyway, but it makes the try-order
# non-deterministic instead of what you intended).
# Default: mock. You do not need to change this even with real keys set —
# mock is always tried last regardless of this setting; this only affects
# which REAL provider is preferred first when you have more than one key set.
AI_DEFAULT_PROVIDER=mock

# Comma-separated provider *names* (see list above), the fallback order
# after AI_DEFAULT_PROVIDER. "mock" is always forced to the end of the
# effective order regardless of what you put here, so you never need to
# include it. Any provider registered but not mentioned here still gets
# tried (just after the ones you did list) — this list doesn't need to be
# exhaustive.
# Default: mock
AI_FALLBACK_PROVIDERS=gemini,qwen

# Per-Telegram-user daily spend cap in USD, across all AI features
# combined. Once hit, that user's requests fail with a budget error
# (server-wide budget below still applies on top). 0 = no per-user cap.
# Default: 0.50
AI_MAX_USER_COST_USD_DAY=0.50

# Total AI spend cap in USD per UTC day, across every user and every
# background job combined (includes /ai_probe's tiny diagnostic calls).
# Default: 25.00
AI_MAX_GLOBAL_COST_USD_DAY=25.00

# How long (seconds) an identical request (same feature + user + prompt)
# is served from cache instead of hitting a provider again. 0 disables
# caching. A response that was cut off mid-completion is never cached
# regardless of this setting, so "Refresh" after a truncation always
# retries for real.
# Default: 120
AI_CACHE_TTL_SECONDS=120

# ------------------------------------------------------------------------------
# AI Foundation — individual providers (set only the ones you actually use)
# ------------------------------------------------------------------------------

# Anthropic (Claude). Recommended default choice if you're only setting up
# one real provider — no known account-activation gotchas like Gemini's
# free-tier cap or Qwen's per-model purchase requirement below.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# DeepSeek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Qwen (Alibaba Cloud DashScope, OpenAI-compatible endpoint).
# CONFIRMED GOTCHA (live, 2026-08-02): a valid API key alone is not
# enough — DashScope/Model Studio requires explicitly activating access to
# the specific model on your account, separately from having a key at all.
# The default model below (qwen-plus) returned
# "AccessDenied.Unpurchased: Access is denied to this model" on the
# project's own account. Either activate qwen-plus in your DashScope
# console, or point QWEN_MODEL at a model you've already activated.
# Use /ai_probe after setting this to confirm which case you're in.
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
# Default is the international (Singapore) endpoint. Mainland China
# deployments should use the dashscope.aliyuncs.com equivalent instead.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Grok (xAI). Model naming has shifted repeatedly through 2026 — check
# https://docs.x.ai/docs/models if this starts failing with a
# model-not-found error.
GROK_API_KEY=
GROK_MODEL=grok-4-fast

# Gemini (Google).
# CONFIRMED GOTCHA (live, 2026-08-02): Google AI Studio's free tier caps
# gemini-3.5-flash at 20 requests/day, tracked PER MODEL, not per account.
# GEMINI_MODEL_FALLBACKS (below) already cycles through other free-tier
# models automatically once the primary one is quota-exhausted for the
# day — this does not require a paid Google Cloud billing account, but
# each fallback model has its own separate small free-tier cap, so heavy
# usage will still eventually exhaust all of them in one day. Upgrade to a
# paid Gemini API billing tier for real production headroom.
# CONFIRMED GOTCHA #2 (live via /ai_probe, 2026-08-05): Google retires
# specific model IDs over time — gemini-2.5-flash-lite (a previous
# default fallback here) started returning NOT_FOUND ("no longer
# available to new users"). The fallback list below is current as of
# 2026-08-05; the provider now also treats NOT_FOUND as "try the next
# fallback model" (not just quota/overload errors), so a future
# deprecation like this one degrades gracefully instead of blocking
# every model listed after it — but the list itself can still go stale.
# If /ai_probe ever reports a Gemini NOT_FOUND error again, check
# https://ai.google.dev/gemini-api/docs/deprecations for current model
# names and update this list.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Additional models tried, in order, on a quota/overload/model-retired
# error (never on a bad-key or malformed-request error, which fails
# immediately instead). Set to "none" to disable and fail straight to
# the next provider (Qwen/mock) instead of cycling models.
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite

# Ollama (self-hosted open-weight models). No API key — leave
# OLLAMA_BASE_URL unset to keep this provider disabled (the default).
# Only relevant if you're running your own inference server somewhere
# reachable from Render.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1


# ==============================================================================
# NOT FOR RENDER — local development / CI only
# ==============================================================================

# Separate Postgres database used only by the schema/migration test suite
# (never touched by the live bot process). Do not set this on Render.
SCHEMA_TEST_DATABASE_URL=
